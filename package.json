{
  "name": "taktra",
  "version": "1.0.0",
  "description": "Taktra (task + traction): a personal accountability agent over Telegram. Captures tasks and notes, manages Google Calendar, and follows up until things are closed out.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "google:auth": "node --env-file-if-exists=.env scripts/google-auth.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@chat-adapter/telegram": "^4.39.0",
    "@mastra/core": "1.63.2",
    "@mastra/duckdb": "1.6.3",
    "@mastra/libsql": "1.22.2",
    "@mastra/memory": "1.28.1",
    "@mastra/observability": "1.17.4",
    "googleapis": "^176.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "mastra": "1.27.2",
    "typescript": "^6.0.3"
  }
}
