# --- Model provider ---
OPENAI_API_KEY=

# Models, in Mastra's `provider/model` form. Both are optional; the defaults below are
# what the code falls back to when the variable is unset.
# Main agent: all reasoning, chat, and tool calls.
AGENT_MODEL=openai/gpt-5.6-terra
# Scheduled check-ins. Formulaic work, so it runs on a cheaper model than chat.
NUDGE_MODEL=openai/gpt-5.6-luna
# Observational memory and thread titles: cheap background summarizing.
MEMORY_MODEL=openai/gpt-5.6-luna

# --- You ---
# IANA timezone, e.g. Asia/Baghdad
TIMEZONE=UTC

# --- Telegram ---
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to talk to the agent.
TELEGRAM_ALLOWED_USER_IDS=
# Numeric private chat ID used for scheduled reminders.
TELEGRAM_OWNER_CHAT_ID=

# --- Voice notes ---
# Transcription provider. Omit to choose automatically: self-hosted when WHISPER_URL is
# set, otherwise the hosted API. Values: local | openai
TRANSCRIBE_PROVIDER=
# A self-hosted whisper.cpp or faster-whisper server exposing the OpenAI-compatible route.
# No per-minute cost, but it wants memory the host may not have.
WHISPER_URL=
WHISPER_MODEL=
# Hosted fallback. About a tenth of a cent a minute and nothing to run.
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Google Calendar ---
# From an OAuth 2.0 "Desktop app" client in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produced by: npm run google:auth
GOOGLE_REFRESH_TOKEN=
# Optional: a specific calendar id instead of the account's default.
GOOGLE_CALENDAR_ID=primary

# --- Storage ---
# Absolute paths only. A relative path resolves against the bundle directory, which
# `npm run build` empties — state would be destroyed on every deploy. Docker Compose sets
# both of these to the mounted volume and overrides whatever is here.
TURSO_DATABASE_URL=file:/absolute/path/to/mastra.db
DUCKDB_PATH=/absolute/path/to/mastra.duckdb
# DuckDB claims 80% of system RAM by default, which is far too much alongside an app
# server on a small host.
DUCKDB_MEMORY_LIMIT=512MB

# Optional: a hosted Turso database instead of the local file.
TURSO_AUTH_TOKEN=
